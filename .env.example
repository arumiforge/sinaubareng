# Every key from docs/final/server-setup.md section 10, plus the app's own.
# Values stay empty here; the server's .env holds the real ones (LOG-1).

APP_NAME=SIGRAK
APP_ENV=
APP_DEBUG=
APP_KEY=
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# One codebase, three hostnames (D-048, D-069), e.g. app.sigrak.com, ujian.sigrak.com, admin.sigrak.com
APP_HOST=
EXAM_HOST=
ADMIN_HOST=

LOG_CHANNEL=stack
LOG_STACK=
LOG_DAILY_DAYS=
LOG_LEVEL=

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

QUEUE_CONNECTION=
CACHE_STORE=
SESSION_DRIVER=
SESSION_SECURE_COOKIE=
# SESSION_DOMAIN stays unset: app and exam site must not share cookies

TELESCOPE_ENABLED=

# Transactional mail (invitations, password reset) through Gmail SMTP with an App Password (D-110)
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# spatie/laravel-pdf v2 Gotenberg driver (config/laravel-pdf.php reads these keys)
LARAVEL_PDF_DRIVER=
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
